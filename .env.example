# Server
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
APP_UID=1000
APP_GID=1000
IMGW_HOST=0.0.0.0
IMGW_PORT=8080
IMGW_LOG_LEVEL=info

# Persistent application storage
IMGW_DATA_DIR=/data

# Optional path to the built React application
IMGW_STATIC_DIR=/app/static

# IMGW CMM MERGE client
IMGW_BASE_URL=https://cmm.imgw.pl/wp-content/uploads/production/MERGE
IMGW_USER_AGENT=imgw-merge-weather/1.0 homelab-weather-viewer
IMGW_CONNECT_TIMEOUT_SECONDS=5
IMGW_READ_TIMEOUT_SECONDS=20
IMGW_MAX_RETRIES=3
IMGW_RETRY_BACKOFF_SECONDS=0.5
IMGW_FRAME_CONCURRENCY=4
IMGW_MIN_FRAME_BYTES=1024
IMGW_MIN_FRAME_WIDTH=100
IMGW_MIN_FRAME_HEIGHT=100

# Forecast time model
IMGW_FRAME_INTERVAL_MINUTES=10
IMGW_FORECAST_HOURS=8
IMGW_MAX_START_FALLBACK_STEPS=6
IMGW_ALLOW_MISSING_FRAMES=false
IMGW_MIN_FRAME_COVERAGE=0.90

# MP4 generation
IMGW_VIDEO_FPS=5
IMGW_VIDEO_CODEC=libx264
IMGW_VIDEO_CRF=20
IMGW_VIDEO_PRESET=medium
IMGW_SQUARE_VIDEO_SIZE=1080
IMGW_MIN_VIDEO_BYTES=1024
IMGW_VIDEO_TIMEOUT_SECONDS=300
IMGW_FFMPEG_BINARY=ffmpeg
IMGW_FFPROBE_BINARY=ffprobe

# Automatic refresh (recommended homelab schedule shown; disabled by default)
IMGW_SCHEDULER_ENABLED=false
IMGW_SCHEDULER_CRON=2 * * * *
IMGW_SCHEDULER_MISFIRE_GRACE_SECONDS=60
